<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Codex Playground</title>
    <style>
      body { font-family: Arial, sans-serif; margin: 0; background: #f4f7fb; color: #111827; }
      .container { max-width: 860px; margin: 56px auto; padding: 0 20px; }
      h1 { margin-bottom: 8px; }
      p { color: #4b5563; }
      ul { list-style: none; margin: 24px 0 0; padding: 0; display: grid; gap: 12px; }
      li { background: #fff; border: 1px solid #dbe2ea; border-radius: 10px; padding: 14px 16px; }
      a { color: #2563eb; text-decoration: none; font-weight: 700; }
      a:hover { text-decoration: underline; }
      .path { display: block; margin-top: 4px; color: #6b7280; font-size: 13px; }
    </style>
  </head>
  <body>
    <main class="container">
      <h1>Codex Playground</h1>
      <p>Projects currently available in the <code>apps/</code> workspace:</p>
      <ul>
        <li>
          <a href="../apps/calculator/index.html">Calculator</a>
          <span class="path">apps/calculator</span>
        </li>
      </ul>
    </main>
  </body>
</html>
